PROJECT_NAME=Jinbi Lesson Management
PROJECT_VERSION=0.1.0
APP_ENV=development
DEBUG=false
DATABASE_ECHO=false

MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=lesson_user
MYSQL_PASSWORD=replace_with_local_database_password
MYSQL_DB=lesson_demo
MYSQL_CHARSET=utf8mb4

# Generate an independent random value before starting the backend.
JWT_SECRET_KEY=
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Optional AI service. Never put a real key in this template.
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat

# Required only when intentionally running seed.py on a development database.
SEED_ADMIN_PASSWORD=
